# Testnet-only BIP-39 seed. Generate one with `npm run new-wallet`. NEVER use a real seed here.
SEED=

# Plasma testnet RPC (chain 9746)
RPC_URL=https://testnet-rpc.plasma.to

# Optional: unshield to this public address instead of Dave (account #FRESH_ACCOUNT)
RECIPIENT_PUBLIC=
# Dave: the public account index that receives the unshield (bump it for a never-used address)
FRESH_ACCOUNT=1

# Token to shield: TUSDT (demo test USDT, default), USDT0 or any ERC-20 address the pool accepts
TOKEN=TUSDT

# Optional: max estimated network fee per public tx (approve/deposit), in XPL
MAX_FEE_XPL=0.01
